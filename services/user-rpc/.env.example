# Copy this file to .env and replace every placeholder with a local value.
# Never commit the resulting .env file.
MAIL_HOST=smtp.example.com
MAIL_USERNAME=your-account@example.com
MAIL_PASSWORD=replace-me
MAIL_FROM=your-account@example.com
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=sharely-local
USER_DEFAULT_AVATAR=https://example.com/default-avatar.png

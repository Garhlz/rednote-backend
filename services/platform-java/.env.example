# Local development only. Copy to .env and replace values as needed.
DB_URL=jdbc:mysql://localhost:3306/user_db?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=root
DB_PASSWORD=123456

MONGO_URI=mongodb://localhost:27017/rednote
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=admin
ELASTICSEARCH_URIS=http://localhost:9200

JWT_SECRET=defaultSecretForDevOnly123456
POST_AUDIT_ENABLE=false
FILE_BASE_URL=http://localhost:8080/uploads/

# Optional third-party capabilities. Use test-only credentials when enabled.
MAIL_HOST=smtp.example.com
MAIL_USERNAME=disabled@example.com
MAIL_PASSWORD=disabled
ALIYUN_OSS_ENDPOINT=oss-cn-shenzhen.aliyuncs.com
ALIYUN_ACCESS_KEY_ID=disabled
ALIYUN_ACCESS_KEY_SECRET=disabled
ALIYUN_BUCKET_NAME=disabled
WECHAT_APPID=disabled
WECHAT_SECRET=disabled
TENCENT_IM_SDK_APPID=0
TENCENT_IM_SECRET_KEY=disabled
DEEPSEEK_API_KEY=disabled
QWENVL_API_KEY=disabled
